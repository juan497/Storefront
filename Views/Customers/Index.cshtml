
@model IEnumerable<Storefront.Models.Customer>//• IEnumerable<...>: This is a standard C# interface that says, "Expect a collection or a list of these items."


@{
    ViewData["Title"] = "Customers";//this name is used in the _Layout.cshtml file to set the title of the page
}

<h1>Customers</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>City</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        @*Once the controller passes that data over, you access the actual data inside your View using the capitalized Model keyword *@
        {
            <tr>
                <td>@customer.Id</td>
                <td>
                    @customer.FirstName @customer.LastName
                </td>
                <td>@customer.Email</td>
                <td>@customer.City</td>
                <td>
                    <a asp-controller="Customers"
                       asp-action="Details"
                       asp-route-id="@customer.Id">
                        View
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
