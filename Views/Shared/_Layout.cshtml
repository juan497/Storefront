<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Storefront</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Storefront.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="store-navbar">
            <a class="store-logo" asp-controller="Home" asp-action="Index">
                Storefront
            </a>

            <form class="store-search"
                asp-controller="Products"
                asp-action="Index"
                method="get">
                <input type="text"
                    name="search"
                    placeholder="Search Storefront"
                    aria-label="Search products" />
                <button type="submit">Search</button>
            </form>

            @if (User.IsInRole("Admin"))
            {
                <a class="store-nav-link"
                   asp-controller="Customers"
                   asp-action="Index">
                    Customers
                </a>
            }

            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
            {
                <a class="store-nav-link"
                   asp-controller="Orders"
                   asp-action="Index">
                    My Orders
                </a>
            }

            <a class="store-nav-link"
               asp-controller="Cart"
               asp-action="Index">
                Cart
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="store-nav-link btn btn-link p-0">Logout</button>
                </form>
            }
            else
            {
                <a class="store-nav-link"
                   asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>
            }
        </nav>

        <div class="store-subnav">
            <a asp-controller="Home" asp-action="Index">Home</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Products" asp-action="Create">Add Product</a>
                <a asp-controller="Invoices" asp-action="Index">Invoices</a>
                <a asp-controller="Reports" asp-action="Index">Reports</a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Orders" asp-action="Index">My Orders</a>
            }
        </div>
    </header>


    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <!-- Your existing footer, if you have one -->
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
