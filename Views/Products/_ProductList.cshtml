@model IEnumerable<Product>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-info">
        @TempData["CartMessage"]
    </div>
}

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? "/images/no-image.svg" : product.ImageUrl)"
                     alt="@product.Name"
                     class="card-img-top"
                     style="height: 220px; object-fit: cover; background-color: #f3f4f6;" />

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="text-muted mb-2">@product.Category</p>
                    <p class="card-text">@product.Description</p>
                    <h4 class="text-primary">@product.Price.ToString("C")</h4>
                    <p>In stock: @product.StockQuantity</p>

                    <a asp-controller="Products"
                       asp-action="Details"
                       asp-route-id="@product.Id"
                       class="btn btn-outline-primary mb-3">
                        View Details
                    </a>

                    <hr />

                    @if (product.StockQuantity > 0)
                    {
                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post"
                              class="mt-auto">
                            <input type="hidden"
                                   name="productId"
                                   value="@product.Id" />
                            <label for="quantity-@product.Id" class="form-label">
                                Quantity
                            </label>
                            <input id="quantity-@product.Id"
                                   type="number"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   max="@product.StockQuantity"
                                   class="form-control mb-3"
                                   required />
                            <button type="submit" class="btn btn-success w-100">
                                Add to Cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>
                            Out of Stock
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>
