```cshtml
@model IEnumerable<Storefront.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="store-container">
    <section class="store-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <p class="text-uppercase fw-bold text-warning mb-2">Catalog</p>
            <h1>All products</h1>
        </div>

        <a asp-action="Create" class="store-button">Add Product</a>
    </section>

    @await Html.PartialAsync("~/Views/Products/_ProductList.cshtml", Model)
</div>
```