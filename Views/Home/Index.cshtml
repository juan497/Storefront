@model IEnumerable<Product>

<div class="store-container">

    <section class="store-hero">
        <h1>Welcome to Storefrontddd</h1>
        <p>
            Discover great products at great prices.
            Find something you'll love.
        </p>

        <div class="d-flex flex-wrap gap-3">
            <a class="store-button"
               asp-controller="Products"
               asp-action="Index">
                Shop Now
            </a>
            <a class="store-button"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        </div>
    </section>

    <h2 class="store-section-title">Explore Storefront</h2>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="product-card">
                <h5>Browse Products</h5>
                <p>Explore our available products and discover something new.</p>
                <a class="store-button"
                   asp-controller="Products"
                   asp-action="Index">
                    Shop Products
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="product-card">
                <h5>Your Orders</h5>
                <p>Review orders and track their current status.</p>
                <a class="store-button"
                   asp-controller="Orders"
                   asp-action="Index">
                    View Orders
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="product-card">
                <h5>Shopping Cart</h5>
                <p>View your selected products before checking out.</p>
                <a class="store-button"
                   asp-controller="Cart"
                   asp-action="Index">
                    View Cart
                </a>
            </div>
        </div>
    </div>

    <section class="mt-5">
        <h2 class="store-section-title">Products</h2>
        @await Html.PartialAsync("~/Views/Products/_ProductList.cshtml", Model)
    </section>

</div>
