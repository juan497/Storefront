@model IEnumerable<Product>

@{
    ViewData["Title"] = "Home";
}

<div class="store-container">
    <section class="store-hero">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4">
            <div>
                <p class="text-uppercase fw-bold text-warning mb-2">New season</p>
                <h1>Shop the everyday essentials</h1>
                <p>Browse top-rated products, everyday essentials, and best sellers curated for your home and workspace.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Products" asp-action="Index" class="store-button">Browse catalog</a>
            </div>
        </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="store-section-title mb-0">Featured products</h2>
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-warning fw-semibold">View all</a>
    </div>

    @await Html.PartialAsync("~/Views/Products/_ProductList.cshtml", Model)
</div>
