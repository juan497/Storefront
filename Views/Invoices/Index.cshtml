
@model IEnumerable<Storefront.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<h1>Invoices</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Invoice</th>
            <th>Order</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            var order = Storefront.Data.StoreData.Orders
                .FirstOrDefault(o => o.Id == invoice.OrderId);

            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@invoice.OrderId</td>
                <td>@invoice.InvoiceDate.ToString("MMM dd, yyyy")</td>
                <td>@invoice.PaymentStatus</td>
                <td>
                    @(order?.Total.ToString("C") ?? "N/A")
                </td>
                <td>
                    <a asp-controller="Invoices"
                       asp-action="Details"
                       asp-route-id="@invoice.Id"
                       class="btn btn-primary btn-sm">
                        View Invoice
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
