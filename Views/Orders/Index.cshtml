
@model IEnumerable<Storefront.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var customerNames = (Dictionary<int, string>)ViewBag.CustomerNames;
}

<h1>Orders</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>
                    @(customerNames.TryGetValue(order.CustomerId, out var customerName)
                        ? customerName
                        : "Unknown")
                </td>
                <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                <td>@order.Status</td>
                <td>@order.Total.ToString("C")</td>
                <td>
                    <a asp-controller="Orders"
                       asp-action="Details"
                       asp-route-id="@order.Id"
                       class="btn btn-primary btn-sm">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
